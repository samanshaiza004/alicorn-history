-fill_surface_samples :: proc(samples: ^[dynamic]f32, phase: f32) {
-	for i := 0; i < len(samples^); i += 1 {
-		x := f32(i) / f32(len(samples^)-1)
-		samples^[i] = 0.5 + 0.30*math.sin(x*18 + phase) + 0.12*math.sin(x*43 - phase*0.7)
-	}
-}
