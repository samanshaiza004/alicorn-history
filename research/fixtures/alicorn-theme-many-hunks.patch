+theme_cli_core_role :: proc(name: string) -> (theme.Core_Color_Role, alicorn.Style_Color_Role, bool) {
+	switch name {
+	case "window_background": return .Window_Background, .Window_Background, true
+	case "surface": return .Surface, .Surface, true
+	case "subtle_surface": return .Subtle_Surface, .Subtle_Surface, true
+	case "editor_background": return .Editor_Background, .Editor_Background, true
+	case "text": return .Text, .Text, true
+	case "muted_text": return .Muted_Text, .Muted_Text, true
+	case "accent": return .Accent, .Accent, true
+	case "accent_hover": return .Accent_Hover, .Accent_Hover, true
+	case "accent_pressed": return .Accent_Pressed, .Accent_Pressed, true
+	case "accent_text": return .Accent_Text, .Accent_Text, true
+	case "selection": return .Selection, .Selection, true
+	case "focus": return .Focus, .Focus, true
+	case "semantic_focus": return .Semantic_Focus, .Semantic_Focus, true
+	case "border": return .Border, .Border, true
+	case "danger": return .Danger, .Danger, true
+	case "success": return .Success, .Success, true
+	case "scrollbar_track": return .Scrollbar_Track, .Scrollbar_Track, true
+	case "scrollbar_thumb": return .Scrollbar_Thumb, .Scrollbar_Thumb, true
+	}
+	return .Window_Background, .Window_Background, false
+}
