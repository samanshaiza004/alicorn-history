+theme_cli_explain_core_role :: proc(output: theme.Theme_Compile_Output, runtime_theme: alicorn.Style_Theme, input_path, name: string) -> int {
+	role, runtime_role, known := theme_cli_core_role(name)
+	if !known {
+		fmt.eprintfln("{:s}: error: unknown core color role: {:s}", input_path, name)
+		return 1
+	}
+	value := runtime_theme.colors[int(runtime_role)]
+	fmt.printfln("role: {:s}", name)
+	fmt.printfln("value: linear-srgb({:.7g}, {:.7g}, {:.7g}, alpha={:.7g})", value.r, value.g, value.b, value.a)
+	binding_index := -1
+	for binding, index in output.debug.core_roles {
+		if binding.role == role { binding_index = index; break }
+	}
+	if binding_index < 0 {
+		fmt.println("origin: Alicorn DEFAULT_STYLE_THEME fallback (no source binding)")
+		return 0
+	}
+	binding := output.debug.core_roles[binding_index]
+	fmt.printfln("binding: {:s} at {:s}:{:d}:{:d}", binding.token, binding.span.path, binding.span.line, binding.span.column)
+	provenance_index := -1
+	for token, index in output.debug.tokens {
+		if token.name == binding.token { provenance_index = index; break }
+	}
+	if provenance_index < 0 {
+		fmt.eprintfln("{:s}: error: compiler returned missing token provenance for role {:s}", input_path, name)
+		return 1
+	}
+	token := output.debug.tokens[provenance_index]
+	for hop in 0..<len(output.debug.tokens) {
+		fmt.printfln("value source: {:s} at {:s}:{:d}:{:d}", token.name, token.span.path, token.span.line, token.span.column)
+		if token.alias_target == "" { break }
+		next_index := -1
+		for candidate, index in output.debug.tokens {
+			if candidate.name == token.alias_target { next_index = index; break }
+		}
+		if next_index < 0 {
+			fmt.eprintfln("{:s}: error: compiler returned missing alias provenance for {:s}", input_path, token.alias_target)
+			return 1
+		}
+		token = output.debug.tokens[next_index]
+	}
+	return 0
+}
