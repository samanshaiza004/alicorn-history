+		}
+	}
+	if text_clip.w > 0 {
+		append(commands, alicorn.paint_text_command(label.host_node,
+			alicorn.Rect{clip.x, y, run.width, run.height}, text_clip,
+			native_text_host_handle(state.text_renderer, label.host_node), color))
+	}
